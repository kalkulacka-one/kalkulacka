{
  "name": "@kalkulacka-one/next",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-helpers.d.ts",
      "default": "./dist/config-helpers.js"
    },
    "./session": {
      "types": "./dist/session/shared/index.d.ts",
      "default": "./dist/session/shared/index.js"
    },
    "./session/client": {
      "types": "./dist/session/client/index.d.ts",
      "default": "./dist/session/client/index.js"
    },
    "./session/server": {
      "types": "./dist/session/server/index.d.ts",
      "default": "./dist/session/server/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    },
    "./link": {
      "types": "./dist/link/next-link-provider.d.ts",
      "default": "./dist/link/next-link-provider.js"
    },
    "./monitoring/client": {
      "types": "./dist/monitoring/client/index.d.ts",
      "default": "./dist/monitoring/client/index.js"
    },
    "./monitoring/server": {
      "types": "./dist/monitoring/server/index.d.ts",
      "default": "./dist/monitoring/server/index.js"
    },
    "./api/routes/*": {
      "types": "./dist/api/routes/*.d.ts",
      "default": "./dist/api/routes/*.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "ncu": "ncu",
    "ncu:upgrade": "ncu -u"
  },
  "dependencies": {
    "@appsignal/javascript": "^1.6.1",
    "@appsignal/plugin-breadcrumbs-network": "^1.1.24",
    "@appsignal/plugin-window-events": "^1.0.26",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@vercel/otel": "^2.1.3",
    "@kalkulacka-one/app": "*",
    "@kalkulacka-one/database": "*",
    "@kalkulacka-one/design-system": "*",
    "zod": "^4.0.0",
    "@kalkulacka-one/schema": "*"
  },
  "devDependencies": {
    "@kalkulacka-one/typescript-config": "*",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "react": "^19.2.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.2.3"
  },
  "packageManager": "npm@11.5.2"
}
