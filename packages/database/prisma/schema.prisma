generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "cockroachdb"
}

model Subscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email    String
  origin   String
  metadata Json?

  /// `null` means not yet checked
  emailStatus    EmailStatus?
  /// The person withdrew consent (unsubscribe or spam complaint)
  unsubscribedAt DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([email, origin])
}

enum EmailStatus {
  /// Deliverable as far as we can tell
  valid
  /// Bad syntax, a known typo domain, or the domain doesn't exist / has a null MX
  invalid
  /// DNS check failed temporarily, retry
  unverified
  /// Hard bounce reported by the ESP
  bounced
}

enum crdb_internal_region {
  aws_eu_central_1 @map("aws-eu-central-1")
}

model CalculatorSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sessionId         String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculatorId      String  @db.Uuid
  calculatorKey     String
  calculatorGroup   String?
  calculatorVersion String?
  embedName         String?
  publicId          String? @unique @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  data CalculatorSessionData?

  @@unique([sessionId, calculatorId])
  @@index([sessionId])
  @@index([calculatorId])
  @@index([calculatorKey])
  @@index([calculatorKey, calculatorGroup])
  @@index([embedName])
  @@index([publicId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
}

model CalculatorSessionData {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @unique @db.Uuid
  answers   Json
  result    Json?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  session CalculatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
