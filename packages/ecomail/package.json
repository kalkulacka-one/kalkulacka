{
  "name": "@kalkulacka-one/ecomail",
  "version": "0.0.0",
  "private": true,
  "description": "Ecomail integration – syncs the Ecomail list state with the database",
  "type": "module",
  "scripts": {
    "pull": "turbo run build --filter=@kalkulacka-one/ecomail^... --output-logs=errors-only && node --no-warnings src/pull.ts",
    "push": "turbo run build --filter=@kalkulacka-one/ecomail^... --output-logs=errors-only && node --no-warnings src/push.ts",
    "sync": "turbo run build --filter=@kalkulacka-one/ecomail^... --output-logs=errors-only && node --no-warnings src/sync-cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ncu": "ncu",
    "ncu:upgrade": "ncu -u",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalkulacka-one/database": "*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@kalkulacka-one/typescript-config": "*",
    "@types/node": "^22.19.1",
    "typescript": "^7.0.2"
  }
}
